<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/gj_tabelog_chip"
    android:layout_marginBottom="8dp"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/gj_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/gj_text_primary"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/gj_publisher"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/gj_tabelog_accent"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/gj_time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/gj_text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/gj_people"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/gj_star"
            android:textSize="12sp" />
    </LinearLayout>

    <Button
        android:id="@+id/gj_join"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:text="举手入席"
        android:textColor="@color/gj_tabelog_accent" />
</LinearLayout>

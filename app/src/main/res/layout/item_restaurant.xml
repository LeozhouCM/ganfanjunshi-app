<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/gj_surface"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeColor="#F0F0F0"
    app:strokeWidth="0.5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/gj_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/gj_text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="山葵家·寿司" />

            <ImageButton
                android:id="@+id/gj_favorite"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/gj_restaurant_favorite"
                android:padding="4dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_star_outline_gray" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_star_orange" />

            <TextView
                android:id="@+id/gj_rating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:textColor="@color/gj_nav_active"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="4.6" />

            <View
                android:layout_width="1dp"
                android:layout_height="12dp"
                android:layout_marginHorizontal="8dp"
                android:background="@color/gj_divider" />

            <TextView
                android:id="@+id/gj_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/gj_text_primary"
                android:textSize="13sp"
                tools:text="¥ 88/人" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/gj_cuisine"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/gj_text_secondary"
                android:textSize="12sp"
                tools:text="日本料理" />

            <View
                android:layout_width="1dp"
                android:layout_height="12dp"
                android:layout_marginHorizontal="8dp"
                android:background="@color/gj_divider" />

            <TextView
                android:id="@+id/gj_distance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/gj_text_secondary"
                android:textSize="12sp"
                tools:text="距你120m" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/gj_open_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/gj_open_status_bg"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="@string/gj_restaurant_open"
                android:textColor="@color/gj_nav_active"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/gj_hours"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/gj_text_secondary"
                android:textSize="12sp"
                tools:text="10:00–22:00" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/gj_social_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/gj_match_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/gj_text_secondary"
                android:textSize="12sp"
                tools:text="3个饭局 · 8人想去" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/gj_bottom_nav_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/gj_background"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingBottom="@dimen/gj_bottom_nav_padding_bottom">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/gj_bottom_nav_bg"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:elevation="8dp"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:paddingTop="8dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:id="@+id/gj_nav_item_map"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="4dp">

            <ImageView
                android:id="@+id/gj_nav_icon_map"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:contentDescription="@string/gj_nav_map"
                android:src="@drawable/ic_nav_map" />

            <TextView
                android:id="@+id/gj_nav_label_map"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/gj_nav_map"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/gj_nav_item_social"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="4dp">

            <ImageView
                android:id="@+id/gj_nav_icon_social"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:contentDescription="@string/gj_nav_social"
                android:src="@drawable/ic_nav_social" />

            <TextView
                android:id="@+id/gj_nav_label_social"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/gj_nav_social"
                android:textSize="11sp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/gj_nav_item_ai"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="0dp">

                <ImageView
                    android:id="@+id/gj_nav_icon_ai"
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:layout_marginTop="-18dp"
                    android:background="@drawable/gj_ai_fab_bg"
                    android:clipToOutline="true"
                    android:contentDescription="@string/gj_nav_ai"
                    android:elevation="10dp"
                    android:outlineProvider="background"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_nav_ai" />

                <TextView
                    android:id="@+id/gj_nav_label_ai"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/gj_nav_ai"
                    android:textSize="11sp" />
            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/gj_nav_item_messages"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="4dp">

                <FrameLayout
                    android:layout_width="32dp"
                    android:layout_height="26dp">

                    <ImageView
                        android:id="@+id/gj_nav_icon_messages"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/gj_nav_messages"
                        android:src="@drawable/ic_nav_messages" />

                    <TextView
                        android:id="@+id/gj_nav_messages_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="16dp"
                        android:layout_gravity="top|end"
                        android:background="@drawable/gj_nav_badge_bg"
                        android:gravity="center"
                        android:minWidth="16dp"
                        android:paddingHorizontal="4dp"
                        android:textColor="@android:color/white"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </FrameLayout>

                <TextView
                    android:id="@+id/gj_nav_label_messages"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/gj_nav_messages"
                    android:textSize="11sp" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:id="@+id/gj_nav_item_profile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="4dp">

            <ImageView
                android:id="@+id/gj_nav_icon_profile"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:contentDescription="@string/gj_nav_profile"
                android:src="@drawable/ic_nav_profile" />

            <TextView
                android:id="@+id/gj_nav_label_profile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/gj_nav_profile"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

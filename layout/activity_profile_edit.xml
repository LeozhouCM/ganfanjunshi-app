<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gj_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/gj_nickname_hint"
            android:textColor="@color/gj_text_secondary" />

        <EditText
            android:id="@+id/gj_nickname_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/gj_nickname_hint"
            android:inputType="textPersonName" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/gj_bio_hint"
            android:textColor="@color/gj_text_secondary" />

        <EditText
            android:id="@+id/gj_bio_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:hint="@string/gj_bio_hint"
            android:inputType="textMultiLine"
            android:minLines="3" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/gj_city_hint"
            android:textColor="@color/gj_text_secondary" />

        <EditText
            android:id="@+id/gj_city_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/gj_city_hint"
            android:inputType="text" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/gj_real_name_hint"
            android:textColor="@color/gj_text_secondary" />

        <EditText
            android:id="@+id/gj_real_name_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/gj_real_name_hint"
            android:inputType="textPersonName" />

        <TextView
            android:id="@+id/gj_credit_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@color/gj_surface"
            android:padding="12dp"
            android:textColor="@color/gj_text_primary" />

        <Button
            android:id="@+id/gj_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/gj_primary"
            android:text="@string/gj_save_profile" />

    </LinearLayout>
</ScrollView>

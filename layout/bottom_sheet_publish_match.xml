<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/gj_card"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/gj_publish_sheet_title"
        android:textColor="@color/gj_text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/gj_title_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/gj_tabelog_chip"
        android:hint="@string/gj_publish_title_hint_short"
        android:padding="12dp"
        android:textColor="@color/gj_text_primary"
        android:textColorHint="@color/gj_text_secondary" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/gj_publish_label_time"
        android:textColor="@color/gj_text_secondary"
        android:textSize="13sp" />

    <LinearLayout
        android:id="@+id/gj_meal_time_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/gj_tabelog_chip"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?android:attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="12dp">

        <TextView
            android:id="@+id/gj_meal_time_display"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/gj_publish_time_hint"
            android:textColor="@color/gj_text_secondary"
            android:textSize="15sp" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@string/gj_publish_label_time"
            android:src="@android:drawable/ic_menu_today"
            app:tint="@color/gj_text_secondary" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/gj_publish_label_people_max"
        android:textColor="@color/gj_text_secondary"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/gj_tabelog_chip"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp">

        <EditText
            android:id="@+id/gj_people_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/gj_publish_people_hint"
            android:inputType="number"
            android:maxLines="1"
            android:text="4"
            android:textColor="@color/gj_text_primary"
            android:textColorHint="@color/gj_text_secondary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/gj_publish_people_unit"
            android:textColor="@color/gj_text_secondary"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/gj_publish_label_budget_per"
        android:textColor="@color/gj_text_secondary"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/gj_tabelog_chip"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/gj_publish_budget_prefix"
            android:textColor="@color/gj_text_primary"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/gj_budget_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/gj_publish_budget_hint"
            android:inputType="number"
            android:maxLines="1"
            android:text="80"
            android:textColor="@color/gj_text_primary"
            android:textColorHint="@color/gj_text_secondary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/gj_publish_budget_suffix"
            android:textColor="@color/gj_text_secondary"
            android:textSize="14sp" />
    </LinearLayout>

    <Button
        android:id="@+id/gj_submit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:backgroundTint="@color/gj_tabelog_accent"
        android:text="@string/gj_publish_match_btn" />
</LinearLayout>
